{
  "manifest_version": 3,
  "name": "Equashare",
  "version": "5.0.2",
  "description": "LaTeX数式をその場でプレビューし、画像(PNG/SVG)やLaTeXソースとしてコピー・保存できる数式エディタ。",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Equashare"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "open-quick-popup": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "簡易入力ポップアップを開く(コードの打ち込みと画像コピーのみ)"
    }
  },
  "permissions": [
    "downloads",
    "storage",
    "clipboardWrite",
    "contextMenus",
    "scripting",
    "activeTab",
    "nativeMessaging"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
